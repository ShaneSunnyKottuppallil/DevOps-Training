upstream fundoo_wsgi {
    server {{appserver}};   # App EC2 private IP:8001
    keepalive 32;
}
server {
    listen 80;
    server_name _;  # swap with your domain later
    # Basic health
    location = /healthz { return 200 'ok'; add_header Content-Type text/plain; }
    location / {
        proxy_pass http://fundoo_wsgi;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_read_timeout 180;
    }
}